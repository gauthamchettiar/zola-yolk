{%- import "macros/sections.html" as paths -%}
{#
  Zola 0.22.1's sitemap.xml, minus posts with list = "never". Entries carry no
  `extra`, so those posts are collected first and matched by permalink.
  On a Zola upgrade, re-apply the filter to the new built-in.
#}
{%- set _paths = paths::resolve(names=config.extra.content_sections | default(value=[]), fallback=true) -%}
{%- set_global _unlisted = [] -%}
{%- for path in _paths | split(pat="\n") -%}
  {%- if path -%}
  {%- set sec = get_section(path=path) -%}
  {%- for candidate in sec.pages -%}
    {%- if candidate.extra.list | default(value=config.extra.list | default(value="always")) == "never" -%}
      {%- set_global _unlisted = _unlisted | concat(with=candidate.permalink) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for sitemap_entry in entries %}
    {%- if sitemap_entry.permalink not in _unlisted %}
    <url>
        <loc>{{ sitemap_entry.permalink | escape_xml | safe }}</loc>
        {%- if sitemap_entry.updated %}
        <lastmod>{{ sitemap_entry.updated }}</lastmod>
        {%- endif %}
    </url>
    {%- endif %}
    {%- endfor %}
</urlset>
